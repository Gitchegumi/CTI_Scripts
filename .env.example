# TradeGumi Configuration Template
# ================================================================
# Copy this file to .env and fill in your values.
# .env is gitignored — your keys will never be committed.
# This file (example.env) IS tracked in git as reference.

# ── Oanda API ─────────────────────────────────────────────────
OANDA_API_KEY=your_oanda_api_key_here
OANDA_ACCOUNT_ID=your_account_id_here
OANDA_BASE_URL=https://api-fxpractice.oanda.com
OANDA_STREAM_URL=https://stream-fxpractice.oanda.com

# ── Discord ───────────────────────────────────────────────────
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_USER_ID=your_discord_user_id_here
DISCORD_WEBHOOK_URL=

# ── Signal Journal ────────────────────────────────────────────
JOURNAL_TOKEN=your_secret_journal_token_here

# ── Run Mode ──────────────────────────────────────────────────
# alert_only | demo | live
TRADEGUMI_MODE=alert_only

# ── CTI Challenge Type ────────────────────────────────────────
CTI_CHALLENGE_TYPE=2-step
CTI_PHASE=1
#CTI_FUNDING_TIER=100000

# ── Database / Cache ──────────────────────────────────────────
# Options: sqlite | postgres
TRADEGUMI_DB_BACKEND=postgres
TRADEGUMI_DATABASE_URL=postgresql://tradegumi:***@postgres:5432/tradegumi
TRADEGUMI_REDIS_URL=redis://redis:6379/0
TRADEGUMI_SQLITE_FALLBACK=true
TRADEGUMI_POSTGRES_PASSWORD=tradegumi

# ── Authentik (optional) ─────────────────────────────────────
# When the dashboard is served behind an Authentik outpost,
# the proxy injects forwarded identity headers.  No token required.
#AUTHENTIK_URL=https://authentik.yourdomain.com

# ── Webhook Callback ──────────────────────────────────────────
TRADEGUMI_CALLBACK_URL=

# ── Market Data ───────────────────────────────────────────────
TRADEGUMI_MARKET_DATA_MODE=streaming
TRADEGUMI_STREAM_RECONNECT_SECONDS=5
TRADEGUMI_STREAM_HEARTBEAT_TIMEOUT_SECONDS=15
TRADEGUMI_STREAM_BACKOFF_MAX_SECONDS=60
TRADEGUMI_STREAM_MAX_RECONNECT_ATTEMPTS=5

# ── Performance Logging ───────────────────────────────────────
TRADEGUMI_PERF_ENABLED=true
TRADEGUMI_PERF_LOG_SECONDS=60

# ── Risk Parameters ───────────────────────────────────────────
MAX_OPEN_POSITIONS=5
RISK_PER_TRADE=0.0025
SL_ATR_MULTIPLIER=3
TP_ATR_MULTIPLIER=12

# ── Volatility Shock Filter ───────────────────────────────────
VOLATILITY_SHOCK_ENABLED=true
SHOCK_M5_TRUE_RANGE_ATR_MULTIPLE=4.0
SHOCK_M15_TRUE_RANGE_ATR_MULTIPLE=3.5
SHOCK_BODY_ATR_MULTIPLE=3.0
SHOCK_BODY_RANGE_ATR_MULTIPLE=3.5
SHOCK_M5_SUPPRESSION_CANDLES=4
SHOCK_M15_SUPPRESSION_CANDLES=3

# ── Pullback / Continuation ───────────────────────────────────
PULLBACK_ENABLED=true
PULLBACK_REQUIRE_1H_ALIGNMENT=true
PULLBACK_STOCH_OVERSOLD=25
PULLBACK_STOCH_OVERBOUGHT=75

# ── Loop Cadence ──────────────────────────────────────────────
TRADEGUMI_PRICE_POLL_SECONDS=1
TRADEGUMI_SIGNAL_ENGINE_SECONDS=5
TRADEGUMI_LOOP_STATE_WRITE_SECONDS=5
TRADEGUMI_WATCHLIST_RELOAD_SECONDS=60

# ── Strategy Metrics ──────────────────────────────────────────
STRATEGY_METRICS_RETENTION_DAYS=90
STRATEGY_METRICS_DEFAULT_DAYS=7
STRATEGY_METRICS_MAX_OPPORTUNITIES=1000
