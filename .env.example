# TradeGumi Configuration
# Copy this file to .env and fill in your values
# .env is gitignored — your keys will never be committed

# ── Oanda API ──────────────────────────────────────────────────────────────
# Get your API key: https://www.oanda.com/account/tpa/personal_token
# Log in → Manage API Access → Generate token
OANDA_API_KEY=your_oanda_api_key_here
OANDA_ACCOUNT_ID=your_account_id_here

# Oanda base URL — use practice for demo, fxtrade for live
# Practice API: https://api-fxpractice.oanda.com
# Practice Stream: https://stream-fxpractice.oanda.com/
# Live API: https://api-fxtrade.oanda.com/
# Live Stream: https://stream-fxtrade.oanda.com/
OANDA_BASE_URL=https://api-fxpractice.oanda.com

# ── Discord ───────────────────────────────────────────────────────────────
# Bot token (preferred): Create a bot at https://discord.com/developers/applications
#   → New Application → Bot → Reset Token.  Invite it to your server with
#   "bot" scope + "Send Messages" + "Read Message History" permissions.
#   All signal alerts will be sent as DMs directly to you — no channel needed.
DISCORD_BOT_TOKEN=your_bot_token_here

# Your numeric Discord user ID.
# Enable Developer Mode in Discord (Settings → Advanced → Developer Mode),
# then right-click your username → Copy User ID.
DISCORD_USER_ID=your_discord_user_id_here

# Webhook fallback — used only if DISCORD_BOT_TOKEN / DISCORD_USER_ID are
# not set.  You can leave this blank once the bot is configured.
DISCORD_WEBHOOK_URL=

# ── Signal Journal ────────────────────────────────────────────────────────
# Password protecting the /journal page on your dashboard.
# Choose any strong passphrase — this is the only thing standing between
# a public visitor and your grading history.
JOURNAL_TOKEN=your_secret_journal_token_here

# ── Run Mode ──────────────────────────────────────────────────────────────
# alert_only = signals to Discord only, no execution (START HERE)
# demo       = signals + Oanda demo execution
# live       = signals + MatchTrader prop execution (Stage 2)
TRADEGUMI_MODE=alert_only

# ── CTI Challenge Type ───────────────────────────────────────────────────
# CTI_CHALLENGE_TYPE = 1-step | 2-step | instant
#   1-step  = 1-Step Challenge (8% profit target, single phase)
#   2-step  = 2-Step Challenge (Phase 1: 10%, Phase 2: 5%)
#   instant = Instant Funding (10% profit target)
# CTI_PHASE = 1 | 2 | 3 (only applies to 1-step and 2-step)
#   1 = Phase 1, 2 = Phase 2, 3 = Funded
# CTI_FUNDING_TIER = Fixed funding tier in dollars (optional, overrides auto-detection)
#   Set this to your purchased funding tier (e.g., 100000 for $100k) so that
#   profit target and loss limits are calculated correctly regardless of balance.
#   If not set, tier is auto-detected from current balance.
#CTI_CHALLENGE_TYPE=2-step
#CTI_PHASE=1
#CTI_FUNDING_TIER=100000

# ── Risk Parameters ───────────────────────────────────────────────────────
# Defaults match CTI strategy — only change if you know what you're doing
# MAX_OPEN_POSITIONS=5
# RISK_PER_TRADE=0.0025
# SL_ATR_MULTIPLIER=3
# TP_ATR_MULTIPLIER=12

# ── TradeGumi AI Infrastructure ───────────────────────────────────────────
# Database path for AI-augmented trading infrastructure
TRADEGUMI_DB_PATH=/path/to/tradegumi.db

# Discord channels for AI decision flow (comma-separated: incoming,outgoing)
TRADEGUMI_DISCORD_CHANNELS=incoming-signals,outgoing-decisions

# Minimum historical pattern matches required for approval
# TRADEGUMI_MIN_PATTERN_MATCHES=5

# Log level (DEBUG, INFO, WARNING, ERROR)
# TRADEGUMI_LOG_LEVEL=INFO